# ------------------------------------------------------------------
# RAG Evaluation Regression Harness - environment configuration
# Copy this file to .env and fill in values; never commit real secrets.
# ------------------------------------------------------------------

# --- LLM judge ----------------------------------------------------
# LLM API key used by the LLM judge backend (RAG_JUDGE_MODE=llm).
# Leave unset to use the deterministic (offline, reproducible) judge.
LLM_API_KEY=your_openai_api_key_here
# OpenAI-compatible endpoint. Change for Azure/HuggingFace/etc.
LLM_JUDGE_BASE_URL=https://api.openai.com/v1
# Pinned judge model (see also config/eval_pins.json).
LLM_JUDGE_MODEL=openai/gpt-4o-mini
# Pinned judge temperature (kept at 0 for determinism/fingerprinting).
LLM_JUDGE_TEMPERATURE=0
# deterministic | llm
RAG_JUDGE_MODE=deterministic

# --- Vector database (Qdrant) --------------------------------------
# Connection details used by docker-compose.yml and the Qdrant index.
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=acme_knowledge_base

# --- Evaluation harness --------------------------------------------
# Where artifacts are written (defaults under the repo root).
EVAL_RESULTS_DIR=results
EVAL_DATASET_PATH=dataset/eval_set.json
EVAL_CORPUS_DIR=dataset/corpus
# Bigram overlap ratio below which Pipeline B's verbosity mode can add
# elaborative (and sometimes ungrounded) content. Mirrors config/eval_pins.json.
RECIPROCITY_THRESHOLD=0.40
LATENCY_WARMUP_RUNS=3